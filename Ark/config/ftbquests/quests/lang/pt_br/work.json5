  "task.00000000000003A5.title": "Recolha 16 fibras vegetais",
  "task.00000000000003A6.title": "Recolha 4 tintoberries",

  "quest.0000000000000305.title": "Min\u00e9rio e Descarga",
  "quest.0000000000000305.quest_subtitle": "Trabalho em pedra, transporte pesado.",
  "quest.0000000000000305.quest_desc": [
    "Um Anquilossauro trabalhando minera pedra natural e min\u00e9rios; blocos colocados por jogadores nunca s\u00e3o tocados.",
    "Descarregue em um ba\u00fa pr\u00f3ximo, ou use Carregar para puxar uma carga de volta."
  ],
  "task.00000000000003A7.title": "Minere 8 ferros brutos com um trabalhador",
  "task.00000000000003A8.title": "Junte 32 pedregulhos"
