  "task.00000000000002A6.title": "Recupere seu primeiro cache",

  "quest.0000000000000206.title": "Levante seu parceiro",
  "quest.0000000000000206.quest_subtitle": "Ningu\u00e9m sangra sob sua vigil\u00e2ncia.",
