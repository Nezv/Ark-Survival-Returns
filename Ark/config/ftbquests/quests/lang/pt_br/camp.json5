  ],
  "task.00000000000002A3.title": "Crie 2 bandagens de fibra",

  "quest.0000000000000204.title": "S\u00edlex e tend\u00e3o",
  "quest.0000000000000204.quest_subtitle": "Fio sem metal.",
  "quest.0000000000000204.quest_desc": [
    "Crie uma faca de s\u00edlex e uma lan\u00e7a de s\u00edlex.",
    "A lan\u00e7a alcan\u00e7a mais longe; a faca \u00e9 r\u00e1pida e fr\u00e1gil."
