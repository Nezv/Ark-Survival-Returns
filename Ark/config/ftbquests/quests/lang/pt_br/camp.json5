  "quest.0000000000000201.title": "Um lugar para voltar",
  "quest.0000000000000201.quest_subtitle": "Acampe primeiro.",
  "quest.0000000000000201.quest_desc": [
    "Crie um rolo de dormir primitivo com quatro fibras vegetais e um couro. Ele ocupa dois blocos, como uma cama.",
    "Coloque-o e use-o para definir seu ponto de renascimento; o ponto permanece mesmo se o rolo for destru\u00eddo."
  ],
  "task.00000000000002A1.title": "Crie o rolo de dormir primitivo",

  "quest.0000000000000202.title": "Fibra da terra",
  "quest.0000000000000202.quest_subtitle": "A terra fornece a amarra\u00e7\u00e3o.",
  "quest.0000000000000202.quest_desc": [
    "Quebre grama curta e alta para obter fibra vegetal; tesouras n\u00e3o a coletam.",
    "A fibra une ferramentas, bandagens e o rolo de dormir."
  ],
  "task.00000000000002A2.title": "Junte 8 fibras vegetais",

  "quest.0000000000000203.title": "Medicina de campo",
  "quest.0000000000000203.quest_subtitle": "Um ferimento \u00e9 um atraso, n\u00e3o um fim.",
  "quest.0000000000000203.quest_desc": [
