  "task.00000000000002A4.title": "Crie uma faca de s\u00edlex",
  "task.00000000000002A5.title": "Crie uma lan\u00e7a de s\u00edlex",

  "quest.0000000000000205.title": "Nada se perde de verdade",
  "quest.0000000000000205.quest_subtitle": "Volte e recolha.",
  "quest.0000000000000205.quest_desc": [
